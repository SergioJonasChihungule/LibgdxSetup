<resources xmlns:tools="http://schemas.android.com/tools"
  xmlns:app="http://schemas.android.com/apk/res-auto" >
  <!-- Base application theme. -->
  <style name="Base.AppTheme" parent="Theme.Material3.DynamicColors.DayNight" >
    <!-- Customize your theme here. -->
    <item name="colorPrimaryDark">?android:attr/colorBackground</item>
       <item name="android:windowLightStatusBar">true</item>
     <item name="textInputStyle">@style/InputStyle</item>
</style>
   
  <style name="AppTheme" parent="Base.AppTheme" />
    
    <style name="InputStyle" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="colorPrimary">@color/colorPrimaryDark</item>
        
    </style>
    <style name="ButtonStyle" parent="Widget.Material3.Button.OutlinedButton">
    </style>
    
    <style name="HintTextSize" parent="TextAppearance.Design.Hint">
    <item name="android:textSize">12sp</item>
</style>

</resources>